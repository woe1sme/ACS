{
  "Kestrel": {
    "Endpoints": {
      "Rest": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      }
    }
  },
  "ConnectionStrings": {
    "Activity": ""
  },
  "Database": {
    "CommandTimeoutSeconds": 30
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest"
  },
  "MessageRetry": {
    "RetryLimit": 5,
    "MinInterval": "00:00:01",
    "MaxInterval": "00:00:30",
    "IntervalDelta": "00:00:02"
  },
  "AllowedHosts": "*",
  "Commission": {
    "GrpcAddress": "http://localhost:6103",
    "DeadlineSeconds": 3,
    "Resilience": {
      "RetryAttempts": 2,
      "AttemptTimeoutSeconds": 1,
      "TotalTimeoutSeconds": 4,
      "BreakerFailureRatio": 0.5,
      "BreakerMinimumThroughput": 5,
      "BreakerBreakSeconds": 15
    }
  }
}