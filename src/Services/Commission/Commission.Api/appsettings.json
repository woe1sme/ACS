{
  "Kestrel": {
    "Endpoints": {
      "Rest": { "Url": "http://+:8080", "Protocols": "Http1" },
      "Grpc": { "Url": "http://+:8081", "Protocols": "Http2" }
    }
  },
  "ConnectionStrings": {
    "Commission": ""
  },
  "Database": {
    "CommandTimeoutSeconds": 30
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest"
  },
  "MessageRetry": {
    "RetryLimit": 5,
    "MinInterval": "00:00:01",
    "MaxInterval": "00:00:30",
    "IntervalDelta": "00:00:02"
  },
  "Partners": {
    "GrpcAddress": "http://localhost:6101",
    "DeadlineSeconds": 5,
    "Resilience": {
      "RetryAttempts": 0,
      "AttemptTimeoutSeconds": 5,
      "TotalTimeoutSeconds": 6,
      "BreakerFailureRatio": 0.5,
      "BreakerMinimumThroughput": 5,
      "BreakerBreakSeconds": 15
    }
  },
  "AllowedHosts": "*"
}
